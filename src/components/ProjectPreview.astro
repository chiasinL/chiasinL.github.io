---

type Props = { project: any; class?: string; headingLevel?: 'h2' | 'h3' };

const { project, class: className, headingLevel = 'h2' } = Astro.props;
const item = project.data || project;
const { title, description, tags } = item;
const TitleTag = headingLevel;

// Convert tag array into bullet-separated string
const formattedTags = Array.isArray(tags) ? tags.join(' • ') : tags;
---

<div class={className}>
    <TitleTag class="font-serif text-xl leading-tight font-medium sm:text-2xl">
        {title}
    </TitleTag>

    {description && (
        <p class="mt-1.5 text-sm leading-normal text-neutral-600 dark:text-neutral-400">
            {description}
        </p>
    )}
    
    {formattedTags && (
        <p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">
            <span class="font-medium text-neutral-700 dark:text-neutral-300">Tech:</span> {formattedTags}
        </p>
    )}
</div>
