---
import projects from '../data/projects.json';
import publications from '../data/publications.json';
import siteConfig from '../data/site-config';
import BaseLayout from '../layouts/BaseLayout.astro';

// Safe helper for splitting/formatting authors and bolding your name
const formatAuthors = (authors: string | string[], max = 3) => {
  const authorList = Array.isArray(authors)
    ? authors
    : typeof authors === 'string'
      ? authors.split(', ')
      : [];

  // If the total author count is within limit, return everyone
  if (authorList.length <= max) {
    return {
      items: authorList.map((name) => ({
        name,
        isUser: /Chia[- ]Sin Liew/i.test(name),
      })),
      hasEtAl: false,
    };
  }

  const userIndex = authorList.findIndex((name) => /Chia[- ]Sin Liew/i.test(name));

  // If user is among the first `max` positions or not found in the list
  if (userIndex === -1 || userIndex < max) {
    return {
      items: authorList.slice(0, max).map((name) => ({
        name,
        isUser: /Chia[- ]Sin Liew/i.test(name),
      })),
      hasEtAl: true,
    };
  }

  // If user is past position `max` (e.g. 4th, 5th author, etc.)
  const items = [
    ...authorList.slice(0, max - 1).map((name) => ({
      name,
      isUser: false,
    })),
    { name: '…', isUser: false },
    { name: authorList[userIndex], isUser: true },
  ];

  return {
    items,
    hasEtAl: userIndex < authorList.length - 1,
  };
};

// 1. Featured papers (with descriptions highlighting computational contributions)
const featuredPubs = publications.filter((pub) => pub.isFeatured);

// 2. Complete bibliography (top 3 visible immediately, rest in expandable list)
const visibleAllPubs = publications.slice(0, 3);
const hiddenAllPubs = publications.slice(3);
---

<BaseLayout title={`Research & Work | ${siteConfig.title}`} description="Publications, computational pipelines, and multi-omics analysis systems.">
  <div class="space-y-16">
    <!-- Header -->
    <header class="space-y-2">
      <h1 class="text-3xl font-bold tracking-tight">Research & Computational Work</h1>
      <p class="text-sm opacity-70">
        Production workflows, analytical frameworks, and peer-reviewed publications.
      </p>
    </header>

    <!-- 1. Pipelines & Analysis Workflows -->
    <section class="space-y-8">
      <h2 class="font-serif text-xl italic sm:text-2xl">
        Pipelines & Analysis Workflows
      </h2>
      <div class="space-y-10 sm:space-y-12">
        {projects.map((proj) => (
          <article class="space-y-2">
            <h3 class="font-serif text-xl font-medium">{proj.title}</h3>
            <p class="text-sm leading-relaxed">{proj.description}</p>
            {proj.tags && (
              <p class="text-xs opacity-70 pt-1">
                <span>Tech:</span> {proj.tags.join(" • ")}
              </p>
            )}
          </article>
        ))}
      </div>
    </section>

    <!-- 2. Selected Publications -->
    <section class="space-y-8">
      <h2 class="font-serif text-xl italic sm:text-2xl">
        Selected Publications
      </h2>
      <div class="space-y-8">
        {featuredPubs.map((pub) => {

          return (
            <article class="space-y-1.5">
              <h3 class="font-serif text-xl font-medium" set:html={pub.title} />
              
              <p class="text-sm">
                {(() => {
                    const { items, hasEtAl } = formatAuthors(pub.authors, 3);
                    return (
                    <Fragment>
                        {items.map((item, index) => (
                        <Fragment>
                            {item.isUser ? (
                            <strong class="font-semibold">{item.name}</strong>
                            ) : (
                            item.name
                            )}
                            {index < items.length - 1 ? ", " : ""}
                        </Fragment>
                        ))}
                        {hasEtAl && ", et al."}
                    </Fragment>
                    );
                })()}
              </p>

              <p class="text-xs italic opacity-70">{pub.journal} ({pub.year})</p>

              {pub.description && (
                <p class="text-sm leading-relaxed pt-1"
                  set:html={pub.description}>
                </p>
              )}

              {pub.doi && (
                <div class="pt-1 text-xs">
                  <a href={pub.doi} target="_blank" rel="noopener noreferrer" class="hover:underline opacity-80">
                    View Article / DOI ↗
                  </a>
                </div>
              )}
            </article>
          );
        })}
      </div>
    </section>

    <!-- 3. All Publications (Master List: Top 3 Visible + Expandable Rest) -->
    <section class="space-y-6">
      <h2 class="font-serif text-xl italic sm:text-2xl">
        All Publications
      </h2>
      
      <!-- Most recent 3 papers from the master list -->
      <div class="space-y-5">
        {visibleAllPubs.map((pub) => {

          return (
            <article class="space-y-1">
              <h3 class="font-serif text-base font-medium" set:html={pub.title} />
              <p class="text-xs opacity-70">
                    {(() => {
                        const { items, hasEtAl } = formatAuthors(pub.authors, 3);
                        return (
                        <Fragment>
                            {items.map((item, index) => (
                            <Fragment>
                                {item.isUser ? (
                                <strong class="font-semibold">{item.name}</strong>
                                ) : (
                                item.name
                                )}
                                {index < items.length - 1 ? ", " : ""}
                            </Fragment>
                            ))}
                            {hasEtAl && ", et al."}
                        </Fragment>
                        );
                    })()}
                {" • "}<span class="italic">{pub.journal} ({pub.year})</span>
              </p>
            </article>
          );
        })}
      </div>

      <!-- Collapsible section for the remaining publications -->
      {hiddenAllPubs.length > 0 && (
        <details class="group cursor-pointer pt-2">
          <summary class="text-xs font-serif italic opacity-70 hover:opacity-100 select-none list-none flex items-center gap-2">
            <span>Show full publication list</span>
            <span class="font-sans not-italic group-open:rotate-180 transition-transform">▼</span>
          </summary>

          <div class="space-y-5 pt-5 cursor-default">
            {hiddenAllPubs.map((pub) => {
              return (
                <article class="space-y-1">
                  <h3 class="font-serif text-base font-medium" set:html={pub.title} />
                  <p class="text-xs opacity-70">
                    {(() => {
                        const { items, hasEtAl } = formatAuthors(pub.authors, 3);
                        return (
                        <Fragment>
                            {items.map((item, index) => (
                            <Fragment>
                                {item.isUser ? (
                                <strong class="font-semibold">{item.name}</strong>
                                ) : (
                                item.name
                                )}
                                {index < items.length - 1 ? ", " : ""}
                            </Fragment>
                            ))}
                            {hasEtAl && ", et al."}
                        </Fragment>
                        );
                    })()}
                    {" • "}<span class="italic">{pub.journal} ({pub.year})</span>
                  </p>
                </article>
              );
            })}
          </div>
        </details>
      )}
    </section>

  </div>
</BaseLayout>